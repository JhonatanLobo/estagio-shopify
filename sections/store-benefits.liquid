{%- comment -%} sections/store-benefits.liquid {%- endcomment -%}
{{ 'store-benefits.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign brand_reference = product.metafields.custom.marca.value
-%}

<div class="store-benefits color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="store-benefits__title inline-richtext {{ section.settings.heading_size }}">
        {{ section.settings.title | escape }}
      </h2>
    {%- endif -%}

    <div class="store-benefits__grid">
      <div class="store-benefits__card">
        <span class="store-benefits__icon">🚚</span>
        <h3 class="store-benefits__card-title text-body-large">Frete Segurado</h3>
        <p class="store-benefits__card-text text-body">Entregamos em todo o Brasil com rastreamento completo e seguro logístico incluso.</p>
      </div>

      <div class="store-benefits__card">
        <span class="store-benefits__icon">💳</span>
        <h3 class="store-benefits__card-title text-body-large">Parcelamento Sem Juros</h3>
        <p class="store-benefits__card-text text-body">Parcele suas compras em até 6x sem juros no cartão de crédito ou garanta desconto no Pix.</p>
      </div>

      {%- comment -%} Card Dinâmico integrado com Metafields / Metaobjects para o Desafio 4.2 {%- endcomment -%}
      <div class="store-benefits__card store-benefits__card--dynamic">
        {%- if brand_reference != blank and brand_reference.logo != blank -%}
          <div class="store-benefits__brand-logo">
            <img 
              src="{{ brand_reference.logo | image_url: width: 80 }}" 
              alt="{{ brand_reference.nome | escape }}" 
              loading="lazy"
              width="40"
              height="40"
            >
          </div>
          <h3 class="store-benefits__card-title text-body-large">Produto Original {{ brand_reference.nome | escape }}</h3>
          <p class="store-benefits__card-text text-body">Item homologado com procedência garantida e suporte direto do fabricante ({{ brand_reference.pais_origem | escape }}).</p>
        {%- else -%}
          <span class="store-benefits__icon">🔒</span>
          <h3 class="store-benefits__card-title text-body-large">Compra Protegida</h3>
          <p class="store-benefits__card-text text-body">Ambiente criptografado com certificação SSL para total proteção dos seus dados fiscais.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | divided_by: 2 }}px;
    padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Destaques da Loja",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título da Seção",
      "default": "Por que comprar conosco?"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h3", "label": "Pequeno" },
        { "value": "h2", "label": "Médio" },
        { "value": "h1", "label": "Grande" }
      ],
      "default": "h2",
      "label": "Tamanho do Título"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de Cores",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento Superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento Inferior",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Destaques da Loja"
    }
  ]
}
{% endschema %}