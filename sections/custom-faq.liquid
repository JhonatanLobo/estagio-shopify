{%- comment -%} sections/custom-faq.liquid {%- endcomment -%}
{{ 'custom-faq.css' | asset_url | stylesheet_tag }}

<div class="custom-faq color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width page-width--narrow">
    {%- if section.settings.title != blank -%}
      <h2 class="custom-faq__title inline-richtext {{ section.settings.heading_size }}">
        {{ section.settings.title }}
      </h2>
    {%- endif -%}

    <div class="custom-faq__items">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          
          {%- when 'faq_item' -%}
            <details class="custom-faq__item" {{ block.shopify_attributes }}>
              <summary class="custom-faq__header">
                <h3 class="custom-faq__question text-body-large">{{ block.settings.question | escape }}</h3>
                <span class="custom-faq__icon">
                  <svg aria-hidden="true" focusable="false" class="icon icon-caret" viewBox="0 0 10 6">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 10-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
                  </svg>
                </span>
              </summary>
              <div class="custom-faq__content rte" id="FAQ-content-{{ block.id }}">
                {{ block.settings.answer }}
              </div>
            </details>
          
          {%- when 'announcement' -%}
            <div class="custom-faq__announcement" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h4 class="custom-faq__announcement-heading">{{ block.settings.heading | escape }}</h4>
              {%- endif -%}
              <div class="custom-faq__announcement-text rte">
                {{ block.settings.text }}
              </div>
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | divided_by: 2 }}px;
    padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "FAQ Customizado",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título Principal",
      "default": "Perguntas Frequentes"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Pequeno" },
        { "value": "h1", "label": "Médio" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1",
      "label": "Tamanho do Título"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de Cores",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Espaçamento da Seção"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento Superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento Inferior",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Pergunta e Resposta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pergunta",
          "default": "Qual o prazo de entrega?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Resposta",
          "default": "<p>Nosso prazo médio de entrega é de 5 a 10 dias úteis.</p>"
        }
      ]
    },
    {
      "type": "announcement",
      "name": "Aviso em Destaque",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título do Alerta",
          "default": "Informação Importante"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Conteúdo do Alerta",
          "default": "<p>Estamos operando normalmente com frete grátis.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Customizado",
      "blocks": [
        { "type": "faq_item" },
        { "type": "announcement" },
        { "type": "faq_item" }
      ]
    }
  ]
}
{% endschema %}