{% style %}
  .hero-banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    width: 100%;
  }

  .hero-banner__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
  }

  .hero-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  .hero-banner__container {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
  }

  .hero-banner__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    max-width: 650px;
    text-align: center;
    margin: 0 auto;
    align-items: center;
  }

  .hero-banner__heading--h1 { font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.2; margin: 0; font-weight: 700; }
  .hero-banner__heading--h2 { font-size: clamp(1.6rem, 4vw, 2.5rem); line-height: 1.3; margin: 0; font-weight: 600; }
  .hero-banner__heading--h3 { font-size: clamp(1.3rem, 3vw, 1.8rem); line-height: 1.4; margin: 0; font-weight: 500; }

  .hero-banner__paragraph {
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.6;
    margin: 0;
  }
  
  .hero-banner__paragraph p {
    margin: 0;
  }

  .hero-banner__button {
    display: inline-block;
    padding: 12px 28px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: opacity 0.2s ease-in-out;
    cursor: pointer;
    margin-top: 10px;
    align-self: center;
  }

  .hero-banner__button:hover {
    opacity: 0.9;
  }

  .hero-banner__button:focus-visible {
    outline: 2px solid #4A90D9;
    outline-offset: 2px;
  }

  .hero-banner__button--primary {
    background-color: var(--btn-color);
    color: #000000;
    border: 1px solid var(--btn-color);
  }

  .hero-banner__button--secondary {
    background-color: transparent;
    color: var(--btn-color);
    border: 2px solid var(--btn-color);
  }

  .hero-banner__image-block {
    display: block;
    width: 100%;
    margin: 10px auto;
  }

  .hero-banner__image-block img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    border-radius: 8px;
  }

  .hero-banner--{{ section.id }} {
    min-height: {{ section.settings.altura_minima }}px;
  }

  @media (min-width: 768px) {
    .hero-banner--align-left .hero-banner__content {
      text-align: left;
      margin: 0 auto 0 0;
      align-items: flex-start;
    }
    .hero-banner--align-left .hero-banner__button {
      align-self: flex-start;
    }
    .hero-banner--align-left .hero-banner__image-block img {
      margin: 0;
    }

    .hero-banner--align-center .hero-banner__content {
      text-align: center;
      margin: 0 auto;
      align-items: center;
    }
    .hero-banner--align-center .hero-banner__button {
      align-self: center;
    }
    .hero-banner--align-center .hero-banner__image-block img {
      margin: 0 auto;
    }

    .hero-banner--align-right .hero-banner__content {
      text-align: right;
      margin: 0 0 0 auto;
      align-items: flex-end;
    }
    .hero-banner--align-right .hero-banner__button {
      align-self: flex-end;
    }
    .hero-banner--align-right .hero-banner__image-block img {
      margin: 0 0 0 auto;
    }
  }
{% endstyle %}

<section class="hero-banner hero-banner--{{ section.id }} hero-banner--align-{{ section.settings.alinhamento }}" aria-label="Hero Banner">
  {%- if section.settings.imagem_fundo != blank -%}
    <img
      srcset="
        {{ section.settings.imagem_fundo | image_url: width: 375 }} 375w,
        {{ section.settings.imagem_fundo | image_url: width: 750 }} 750w,
        {{ section.settings.imagem_fundo | image_url: width: 1100 }} 1100w,
        {{ section.settings.imagem_fundo | image_url: width: 1500 }} 1500w,
        {{ section.settings.imagem_fundo | image_url: width: 1780 }} 1780w,
        {{ section.settings.imagem_fundo | image_url: width: 2000 }} 2000w
      "
      sizes="100vw"
      src="{{ section.settings.imagem_fundo | image_url: width: 1500 }}"
      alt="{{ section.settings.imagem_fundo.alt | escape }}"
      loading="eager"
      fetchpriority="high"
      width="{{ section.settings.imagem_fundo.width }}"
      height="{{ section.settings.imagem_fundo.height }}"
      class="hero-banner__image"
    >
  {%- endif -%}

  {%- assign overlay_opacity = section.settings.opacidade_overlay | divided_by: 100.0 -%}
  <div 
    class="hero-banner__overlay" 
    style="background-color: {{ section.settings.cor_overlay | color_modify: 'alpha', overlay_opacity }};"
  >
    &nbsp;
  </div>

  <div class="hero-banner__container">
    <div class="hero-banner__content">
      {%- for block in section.blocks -%}
        <div class="hero-banner__block hero-banner__block--{{ block.type }} WJ-block-item" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'heading' -%}
              {%- if block.settings.titulo != blank -%}
                <style>
                  .hero-banner__heading--{{ block.id }} {
                    color: {{ block.settings.cor_texto }};
                  }
                </style>
                {%- case block.settings.tamanho_titulo -%}
                  {%- when 'h1' -%}
                    <h1 class="hero-banner__heading hero-banner__heading--h1 hero-banner__heading--{{ block.id }}">{{ block.settings.titulo | escape }}</h1>
                  {%- when 'h2' -%}
                    <h2 class="hero-banner__heading hero-banner__heading--h2 hero-banner__heading--{{ block.id }}">{{ block.settings.titulo | escape }}</h2>
                  {%- when 'h3' -%}
                    <h3 class="hero-banner__heading hero-banner__heading--h3 hero-banner__heading--{{ block.id }}">{{ block.settings.titulo | escape }}</h3>
                {%- endcase -%}
              {%- endif -%}

            {%- when 'paragraph' -%}
              {%- if block.settings.conteudo != blank -%}
                <style>
                  .hero-banner__paragraph--{{ block.id }} {
                    color: {{ block.settings.cor_texto }};
                  }
                </style>
                <div class="hero-banner__paragraph hero-banner__paragraph--{{ block.id }}">
                  {{ block.settings.conteudo }}
                </div>
              {%- endif -%}

            {%- when 'button' -%}
              {%- if block.settings.texto_botao != blank and block.settings.link_botao != blank -%}
                <style>
                  .hero-banner__button--{{ block.id }} {
                    --btn-color: {{ block.settings.cor_texto }};
                  }
                </style>
                <a href="{{ block.settings.link_botao }}" class="hero-banner__button hero-banner__button--{{ block.settings.estilo_botao }} hero-banner__button--{{ block.id }}">
                  {{ block.settings.texto_botao | escape }}
                </a>
              {%- endif -%}

            {%- when 'image' -%}
              {%- if block.settings.imagem_bloco != blank -%}
                {%- assign alt_text = block.settings.alt_text | default: block.settings.imagem_bloco.alt | default: "Imagem interna do banner" -%}
                <div class="hero-banner__image-block" style="max-width: {{ block.settings.largura_maxima }}px;">
                  <img
                    src="{{ block.settings.imagem_bloco | image_url: width: 400 }}"
                    alt="{{ alt_text | escape }}"
                    loading="lazy"
                    width="{{ block.settings.largura_maxima }}"
                    height="{{ block.settings.largura_maxima | divided_by: block.settings.imagem_bloco.aspect_ratio | round }}"
                  >
                </div>
              {%- endif -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "imagem_fundo",
      "label": "Imagem de fundo"
    },
    {
      "type": "color",
      "id": "cor_overlay",
      "label": "Cor do overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "opacidade_overlay",
      "label": "Opacidade do overlay",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "altura_minima",
      "label": "Altura mínima",
      "min": 300,
      "max": 800,
      "step": 50,
      "default": 500,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "alinhamento",
      "label": "Alinhamento do conteúdo",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Direita" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Título",
      "settings": [
        {
          "type": "text",
          "id": "titulo",
          "label": "Texto do título",
          "default": "Título do Hero Banner"
        },
        {
          "type": "select",
          "id": "tamanho_titulo",
          "label": "Tamanho",
          "options": [
            { "value": "h1", "label": "h1" },
            { "value": "h2", "label": "h2" },
            { "value": "h3", "label": "h3" }
          ],
          "default": "h1"
        },
        {
          "type": "color",
          "id": "cor_texto",
          "label": "Cor do texto",
          "default": "#ffffff"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "Parágrafo",
      "settings": [
        {
          "type": "richtext",
          "id": "conteudo",
          "label": "Conteúdo",
          "default": "<p>Adicione um texto descritivo secundário para engajar seus clientes.</p>"
        },
        {
          "type": "color",
          "id": "cor_texto",
          "label": "Cor do texto",
          "default": "#ffffff"
        }
      ]
    },
    {
      "type": "button",
      "name": "Botão",
      "settings": [
        {
          "type": "text",
          "id": "texto_botao",
          "label": "Texto do botão",
          "default": "Clique Aqui"
        },
        {
          "type": "url",
          "id": "link_botao",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "estilo_botao",
          "label": "Estilo",
          "options": [
            { "value": "primary", "label": "Primário/Preenchido" },
            { "value": "secondary", "label": "Secundário/Contorno" }
          ],
          "default": "primary"
        },
        {
          "type": "color",
          "id": "cor_texto",
          "label": "Cor do texto",
          "default": "#ffffff"
        }
      ]
    },
    {
      "type": "image",
      "name": "Imagem",
      "settings": [
        {
          "type": "image_picker",
          "id": "imagem_bloco",
          "label": "Imagem"
        },
        {
          "type": "range",
          "id": "largura_maxima",
          "label": "Largura máxima",
          "min": 50,
          "max": 400,
          "step": 10,
          "default": 150,
          "unit": "px"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "blocks": [
        { "type": "heading" },
        { "type": "paragraph" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}